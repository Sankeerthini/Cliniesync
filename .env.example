# Copy to .env and adjust. Every value has a safe default.

# Freeze "today" for reproducible demos (synthetic data is generated relative to this date)
REFERENCE_DATE=2026-10-19

# Database: SQLite by default; PostgreSQL for production
# DATABASE_URL=postgresql+psycopg://cliniesync:cliniesync@localhost:5432/cliniesync

# Open-source LLM via any OpenAI-compatible server (Ollama default)
LLM_ENABLED=true
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:7b-instruct
# LLM_SQL_MODEL=qwen2.5-coder:7b

# Retrieval
VECTOR_BACKEND=auto          # auto | chroma | tfidf
EMBEDDING_MODEL=default      # default = Chroma ONNX all-MiniLM-L6-v2

# Guardrails
USE_NEMO_GUARDRAILS=true

# Translation of free-text notes (templates are always used for structure)
USE_INDICTRANS=false
# The general chat LLM is NOT used for patient-facing translation (mistranslated clinical terms in testing)
ALLOW_LLM_TRANSLATION=false

# Messaging (Share Report)
#   auto (default): E-MAIL is delivered directly by the server as soon as SMTP is configured (free with Gmail).
#                   WhatsApp/SMS use no paid service: the doctor gets a free WhatsApp click-to-chat link / SMS-app link.
#   sandbox:        nothing leaves the machine (messages saved to data/outbox/).
DELIVERY_MODE=auto
#
# E-mail via Gmail (free, ~500 mails/day). Easiest: run   .venv/bin/python scripts/setup_email.py
# or set by hand: Google Account -> Security -> 2-Step Verification -> App passwords -> create one
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=yourname@gmail.com
# SMTP_PASSWORD=abcdefghijklmnop        # the 16-character app password, not your normal password
# SMTP_FROM=yourname@gmail.com
# SMTP_FROM_NAME=ClinieSync Clinic
#
# Contacts on record are fake in synthetic data, so they are only messaged if allow-listed
# (contacts the doctor types under "Someone else" are always delivered to):
# DELIVERY_ALLOWLIST=+919xxxxxxxxx,teammate@example.org
#
# OPTIONAL paid gateways - only if you want the server itself to send SMS / WhatsApp:
# TWILIO_ACCOUNT_SID= / TWILIO_AUTH_TOKEN= / TWILIO_FROM_NUMBER=
# WHATSAPP_TOKEN= / WHATSAPP_PHONE_NUMBER_ID=
#
# Shared-report links: public address of this portal (e.g. the Cloudflare tunnel URL); empty = the doctor's browser address
# PUBLIC_BASE_URL=https://your-tunnel.trycloudflare.com
REPORT_LINK_DAYS=7
CLINIC_HELPLINE=104

SECRET_KEY=change-me
